
.p1 {
    background-color: lightblue;
}

.p2 {
    border: 3px solid red;
}

.p3 {
    border: 3px solid green;
}

.p4 {
    border: 2px solid purple;
    border-radius: 12px;
}

.p5 {
    border: 3px dotted blue;
}

.p6 {
    border-style: solid;
    border-color: orange;
    border-width: 6px;
}

.p7 {
    position: relative;
    bottom: 10px;
}

.p8 {
    color: crimson;
}

.p9 {
    cursor: pointer;
}

.p10 {
    display: inline-block;
    background-color: lightyellow;
}

.p11 {
    float: right;
    background-color: lightgreen;
}

.p12 {
    font-family: Georgia, serif;
}

.p13 {
    font-size: 22px;
}

.p14 {
    font-style: italic;
}

.p15 {
    font-weight: bold;
}

.p16 {
    height: 60px;
    background-color: lightcyan;
}

.p17 {
    position: relative;
    left: 20px;
}

.p18 {
    line-height: 2.5;
}

.p19 {
    list-style: square;
    list-style-position: inside;
    background-color: #eeeeee;
}

.p20 {
    margin: 20px;
}

.p21 {
    max-width: 250px;
    background-color: lightyellow;
}

.p22 {
    opacity: 0.4;
    background-color: blue;
    color: white;
}

.p23 {
    width: 180px;
    height: 30px;
    overflow: hidden;
    white-space: nowrap;
    background-color: lightpink;
}

.p24 {
    padding: 15px;
    background-color: lavender;
}

.p25 {
    position: relative;
    top: 5px;
}

.p26 {
    position: relative;
    right: 20px;
}

.p27 {
    text-align: center;
}

.p28 {
    text-decoration: underline;
}

.p29 {
    text-transform: uppercase;
}

.p30 {
    position: relative;
    top: 15px;
}

.p31 {
    width: 50%;
    background-color: lightblue;
}

.p32 {
    position: relative;
    z-index: 10;
    background-color: lightyellow;
}

.p33 {
    background-image: linear-gradient(to right, #ff7e5f, #feb47b);
    padding: 15px;
}

.p34 {
    box-shadow: 4px 4px 10px rgba(0, 0, 0, 0.3);
}

.p35 {
    text-shadow: 2px 2px 4px rgba(0, 0, 255, 0.6);
}

.content {
    box-sizing: border-box;
    border: 2px solid black;
    margin-bottom: 20px;
    min-height: 60px;
    width: 100%;
    max-width: 500px;
    padding: 5px;
    background-color: white;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f9;
    margin: 20px;
    color: #222;
}
